{
  "name": "deeppaper-deepseek",
  "version": "0.1.37",
  "description": "A standalone DeepSeek-powered literature analysis workspace.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check app.js && node --check pdf-reader.js && node --check library-ai.js && node scripts/check-pdf-reader.js && node scripts/check-library-ai.js",
    "smoke:pdf-reader": "node scripts/smoke-pdf-reader.e2e.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "5.6.205"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.deeppaper.deepseek",
    "productName": "DeepPaper",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "pdf-reader.js",
      "library-ai.js",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}
